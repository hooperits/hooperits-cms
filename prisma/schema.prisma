// HOOPERITS CMS - Database Schema
// https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// =============================================================================
// ENUMS
// =============================================================================

enum UserRole {
  ADMIN
  EDITOR
  VIEWER
}

enum DocumentStatus {
  DRAFT       // Content has unpublished changes
  PUBLISHED   // Content is live with no pending changes
  SCHEDULED   // Content is scheduled for future publish
  UNPUBLISHED // Content was published but is now hidden
  ARCHIVED    // Content is archived (soft-deleted)
}

enum PublishAction {
  PUBLISH   // Draft → Published
  UNPUBLISH // Published → Unpublished
  SCHEDULE  // Draft → Scheduled
  CANCEL    // Scheduled → Draft
  ARCHIVE   // Unpublished → Archived
  RESTORE   // Archived → Unpublished
}

enum VersionChangeType {
  MANUAL   // User clicked save
  AUTO     // Auto-save
  ROLLBACK // Created by rollback operation
  PUBLISH  // Snapshot at publish time
  IMPORT   // Created via import/migration
}

// =============================================================================
// MODELS
// =============================================================================

/// User model for admin panel authentication and authorization
model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  name      String
  role      UserRole @default(VIEWER)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  createdContent   Content[]      @relation("CreatedBy")
  updatedContent   Content[]      @relation("UpdatedBy")
  publishedContent Content[]      @relation("PublishedContent")
  uploadedMedia    Media[]
  publishEvents    PublishEvent[]
  previewTokens    PreviewToken[]

  // Document versioning relations (spec 004)
  createdVersions  DocumentVersion[]
  updatedPolicies  RetentionPolicy[]

  @@map("users")
}

/// ContentType defines the schema for a type of content
model ContentType {
  id          String   @id @default(uuid())
  name        String   @unique
  label       String
  labelPlural String
  schema      Json
  icon        String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  contents        Content[]
  retentionPolicy RetentionPolicy?

  @@map("content_types")
}

/// Content stores instances of content items
model Content {
  id        String         @id @default(uuid())
  typeId    String
  type      ContentType    @relation(fields: [typeId], references: [id], onDelete: Cascade)
  data      Json
  status    DocumentStatus @default(DRAFT)
  slug      String?
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  // Audit fields
  createdById String
  createdBy   User   @relation("CreatedBy", fields: [createdById], references: [id])
  updatedById String
  updatedBy   User   @relation("UpdatedBy", fields: [updatedById], references: [id])

  // Document state fields (spec 003)
  publishedData   Json?
  publishedAt     DateTime?
  publishedById   String?
  publishedBy     User?     @relation("PublishedContent", fields: [publishedById], references: [id])
  scheduledAt     DateTime?
  archivedAt      DateTime?

  // Relations for document states
  publishEvents  PublishEvent[]
  previewTokens  PreviewToken[]

  // Document versioning relation (spec 004)
  versions       DocumentVersion[]

  // Indexes for common queries
  @@unique([typeId, slug])
  @@index([typeId, status])
  @@index([typeId, createdAt])
  @@index([status])
  @@index([scheduledAt])
  @@index([publishedAt])
  @@map("contents")
}

/// Media stores uploaded files and their variants
model Media {
  id           String   @id @default(uuid())
  filename     String
  mimeType     String
  size         Int
  path         String
  width        Int?
  height       Int?
  variants     Json?
  metadata     Json?
  createdAt    DateTime @default(now())
  uploadedById String
  uploadedBy   User     @relation(fields: [uploadedById], references: [id])

  @@map("media")
}

// =============================================================================
// DOCUMENT STATES (spec 003-document-states)
// =============================================================================

/// PublishEvent stores audit trail for all publishing actions
model PublishEvent {
  id        String        @id @default(uuid())
  contentId String
  content   Content       @relation(fields: [contentId], references: [id], onDelete: Cascade)
  action    PublishAction
  userId    String
  user      User          @relation(fields: [userId], references: [id])
  timestamp DateTime      @default(now())
  metadata  Json?

  @@index([contentId, timestamp])
  @@index([userId, timestamp])
  @@map("publish_events")
}

/// PreviewToken stores temporary tokens for draft preview access
model PreviewToken {
  id        String   @id @default(uuid())
  token     String   @unique @db.VarChar(64)
  contentId String
  content   Content  @relation(fields: [contentId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdBy String
  creator   User     @relation(fields: [createdBy], references: [id])
  createdAt DateTime @default(now())

  @@index([token])
  @@index([contentId])
  @@index([expiresAt])
  @@map("preview_tokens")
}

// =============================================================================
// DOCUMENT VERSIONING (spec 004-document-versioning)
// =============================================================================

/// DocumentVersion stores historical snapshots of content
model DocumentVersion {
  id            String            @id @default(uuid())
  contentId     String
  content       Content           @relation(fields: [contentId], references: [id], onDelete: Cascade)

  // Version data
  versionNumber Int               // Sequential per content (1, 2, 3...)
  data          Json              // Snapshot of Content.data at this point
  changeType    VersionChangeType @default(MANUAL)
  changeSummary String?           // Optional: "Updated title", "Added section"

  // Metadata
  size          Int               // Size in bytes of data JSON
  name          String?           // Optional user-assigned name
  isProtected   Boolean           @default(false) // Protected from retention cleanup

  // Audit
  createdById   String
  createdBy     User              @relation(fields: [createdById], references: [id])
  createdAt     DateTime          @default(now())

  // Performance indexes
  @@unique([contentId, versionNumber])
  @@index([contentId, createdAt])
  @@index([contentId, changeType])
  @@index([createdById])
  @@map("document_versions")
}

/// RetentionPolicy defines version cleanup rules per content type
model RetentionPolicy {
  id            String      @id @default(uuid())
  contentTypeId String      @unique
  contentType   ContentType @relation(fields: [contentTypeId], references: [id], onDelete: Cascade)

  // Policy rules (null = unlimited)
  maxVersions   Int?        // Keep at most N versions per content
  maxAgeDays    Int?        // Delete versions older than N days

  // Behavior
  keepPublished Boolean     @default(true)  // Always keep published versions
  keepNamed     Boolean     @default(true)  // Always keep named versions

  // Audit
  updatedAt     DateTime    @updatedAt
  updatedById   String?
  updatedBy     User?       @relation(fields: [updatedById], references: [id])

  @@map("retention_policies")
}
