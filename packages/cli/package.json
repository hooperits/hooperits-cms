{
  "name": "@hooperits/cli",
  "version": "1.0.0",
  "description": "HOOPERITS CMS CLI for project setup and management",
  "license": "AGPL-3.0",
  "bin": {
    "cms": "./dist/index.js",
    "hooperits-cms": "./dist/index.js"
  },
  "files": [
    "dist",
    "templates"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "lint": "eslint src/",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist",
    "generate": "tsx src/commands/generate.ts",
    "create-admin": "tsx src/commands/create-admin.ts"
  },
  "dependencies": {
    "@hooperits/cms": "workspace:*",
    "commander": "^12.1.0",
    "chalk": "^5.3.0",
    "ora": "^8.0.0",
    "prompts": "^2.4.2"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/prompts": "^2.4.0",
    "eslint": "^8.57.0",
    "tsup": "^8.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.3.0",
    "vitest": "^2.0.0"
  }
}
