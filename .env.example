# =============================================================================
# HOOPERITS CMS - Environment Variables
# =============================================================================
# Copy this file to .env and fill in the values
# Never commit .env to version control!

# -----------------------------------------------------------------------------
# Database (Required)
# -----------------------------------------------------------------------------
# PostgreSQL connection URL
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/hooperits_cms"

# -----------------------------------------------------------------------------
# Authentication (Required)
# -----------------------------------------------------------------------------
# NextAuth secret - generate with: openssl rand -base64 32
NEXTAUTH_SECRET="your-secret-key-min-32-characters-here"

# Base URL of your application
NEXTAUTH_URL="http://localhost:3001"

# -----------------------------------------------------------------------------
# Media Storage (Optional)
# -----------------------------------------------------------------------------
# Storage type: "filesystem" (default) or "s3"
MEDIA_STORAGE="filesystem"

# Local filesystem path for uploads (relative to project root)
MEDIA_PATH="./public/uploads"

# Maximum file size in bytes (default: 10MB)
MEDIA_MAX_SIZE="10485760"

# -----------------------------------------------------------------------------
# S3 Storage (Only if MEDIA_STORAGE=s3)
# -----------------------------------------------------------------------------
# S3_BUCKET="your-bucket-name"
# S3_REGION="us-east-1"
# S3_ACCESS_KEY="your-access-key"
# S3_SECRET_KEY="your-secret-key"
# S3_ENDPOINT="" # Optional: for S3-compatible services like MinIO

# -----------------------------------------------------------------------------
# Image Optimization
# -----------------------------------------------------------------------------
# Image quality for WebP conversion (1-100)
IMAGE_QUALITY="80"

# Generate thumbnail variant (width in pixels)
IMAGE_THUMBNAIL_WIDTH="150"

# Generate medium variant (width in pixels)
IMAGE_MEDIUM_WIDTH="800"

# Generate large variant (width in pixels)
IMAGE_LARGE_WIDTH="1600"

# -----------------------------------------------------------------------------
# Cache (Optional)
# -----------------------------------------------------------------------------
# In-memory cache max entries (default: 1000)
CACHE_MAX_ENTRIES="1000"

# Cache TTL in milliseconds (default: 60000 = 1 minute)
CACHE_TTL="60000"

# -----------------------------------------------------------------------------
# Logging (Optional)
# -----------------------------------------------------------------------------
# Log level: "error", "warn", "info", "debug"
LOG_LEVEL="info"

# -----------------------------------------------------------------------------
# Development
# -----------------------------------------------------------------------------
# Set to "development" or "production"
NODE_ENV="development"
