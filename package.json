{
  "name": "hooperits-cms",
  "version": "1.0.0",
  "private": true,
  "description": "HOOPERITS CMS - Schema-driven headless CMS for Next.js",
  "license": "AGPL-3.0",
  "author": "HOOPERITS Engineering",
  "repository": {
    "type": "git",
    "url": "https://github.com/hooperits/hooperits-cms"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "test:coverage": "turbo run test:coverage",
    "typecheck": "turbo run typecheck",
    "clean": "turbo run clean && rm -rf node_modules",
    "cms:migrate": "turbo run migrate --filter=@hooperits/admin",
    "cms:generate": "turbo run generate --filter=@hooperits/cli",
    "cms:create-admin": "turbo run create-admin --filter=@hooperits/cli"
  },
  "devDependencies": {
    "turbo": "^2.3.0",
    "typescript": "^5.3.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "packageManager": "npm@10.2.0"
}
