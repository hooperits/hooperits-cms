#!/bin/bash
# HOOPERITS Constitution Compliance Hook
# Enforces Section VI: Attribution & Branding Policy
# Rejects commits containing AI tool co-authorship

COMMIT_MSG_FILE="$1"
COMMIT_MSG=$(cat "$COMMIT_MSG_FILE")

# Patterns to detect AI tool attribution
AI_PATTERNS=(
    "Co-Authored-By:.*[Cc]laude"
    "Co-Authored-By:.*[Aa]nthropic"
    "Co-Authored-By:.*[Cc]hat[Gg][Pp][Tt]"
    "Co-Authored-By:.*[Oo]pen[Aa][Ii]"
    "Co-Authored-By:.*[Cc]opilot"
    "Co-Authored-By:.*[Gg]emini"
    "Co-Authored-By:.*noreply@anthropic"
    "Co-Authored-By:.*noreply@openai"
    "Generated with Claude"
    "Generated with ChatGPT"
    "Generated by AI"
    "Built with AI"
    "AI-assisted"
)

for pattern in "${AI_PATTERNS[@]}"; do
    if echo "$COMMIT_MSG" | grep -qiE "$pattern"; then
        echo ""
        echo "╔══════════════════════════════════════════════════════════════════╗"
        echo "║  HOOPERITS CONSTITUTION VIOLATION - Section VI                   ║"
        echo "╠══════════════════════════════════════════════════════════════════╣"
        echo "║  Commit message contains prohibited AI attribution.              ║"
        echo "║                                                                  ║"
        echo "║  Policy: All authorship must be attributed exclusively to        ║"
        echo "║  HOOPERITS Engineering. No Co-Authored-By from AI tools.         ║"
        echo "║                                                                  ║"
        echo "║  Detected pattern: $pattern"
        echo "║                                                                  ║"
        echo "║  To fix: Remove the Co-Authored-By line or AI mention from       ║"
        echo "║  your commit message and try again.                              ║"
        echo "╚══════════════════════════════════════════════════════════════════╝"
        echo ""
        exit 1
    fi
done

exit 0
